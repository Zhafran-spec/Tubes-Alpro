func menuAdmin(T *TabMenu) {
	var pilihan int
	var selesai bool = false

	for !selesai {
		fmt.Println("\n--- MENU ADMIN ---")
		fmt.Println("1. Tambah Data Menu")
		fmt.Println("2. Ubah Data Menu")
		fmt.Println("3. Hapus Data Menu")
		fmt.Println("0. Kembali")
		fmt.Print("Pilih aksi: ")
		fmt.Scan(&pilihan)

		if pilihan == 0 {
			selesai = true
		} else if pilihan == 1 {
			tambahMenu(T)
		} else if pilihan == 2 {
			ubahMenu(T)
		} else if pilihan == 3 {
			hapusMenu(T)
		} else {
			fmt.Println("Pilihan tidak valid.")
		}
	}
}

func tambahMenu(T *TabMenu) {
	if T.n < NMAX {
		fmt.Print("ID Menu: ")
		fmt.Scan(&T.data[T.n].ID)
		fmt.Print("Nama Menu (Gunakan_Underscore_Untuk_Spasi): ")
		fmt.Scan(&T.data[T.n].Nama)
		fmt.Print("Kategori (contoh: coffee/non-coffee): ")
		fmt.Scan(&T.data[T.n].Kategori)
		fmt.Print("Harga Menu: ")
		fmt.Scan(&T.data[T.n].Harga)
		fmt.Print("Komposisi Bahan (Gunakan_Underscore): ")
		fmt.Scan(&T.data[T.n].Komposisi)
		fmt.Print("Status Tersedia (true/false): ")
		fmt.Scan(&T.data[T.n].Tersedia)

		T.n++
		fmt.Println("Berhasil! Data menu ditambahkan.")
	} else {
		fmt.Println("Gagal! Kapasitas menu sudah penuh.")
	}
}

func ubahMenu(T *TabMenu) {
	var idCari string
	fmt.Print("Masukkan ID menu yang akan diubah: ")
	fmt.Scan(&idCari)

	var found bool = false
	var i int = 0

	for i < T.n && !found {
		if T.data[i].ID == idCari {
			found = true
			fmt.Println("Menu ditemukan. Silakan masukkan data baru:")
			fmt.Print("Nama Menu Baru: ")
			fmt.Scan(&T.data[i].Nama)
			fmt.Print("Kategori Baru: ")
			fmt.Scan(&T.data[i].Kategori)
			fmt.Print("Harga Baru: ")
			fmt.Scan(&T.data[i].Harga)
			fmt.Print("Komposisi Baru: ")
			fmt.Scan(&T.data[i].Komposisi)
			fmt.Print("Status Tersedia Baru (true/false): ")
			fmt.Scan(&T.data[i].Tersedia)
			fmt.Println("Berhasil! Data menu diubah.")
		}
		i++
	}

	if !found {
		fmt.Println("Menu dengan ID tersebut tidak ditemukan.")
	}
}

func hapusMenu(T *TabMenu) {
	var idCari string
	fmt.Print("Masukkan ID menu yang akan dihapus: ")
	fmt.Scan(&idCari)

	var found bool = false
	var i int = 0
	var idxHapus int = -1

	for i < T.n && !found {
		if T.data[i].ID == idCari {
			found = true
			idxHapus = i
		}
		i++
	}

	if found {
		var j int = idxHapus
		for j < T.n-1 {
			T.data[j] = T.data[j+1]
			j++
		}
		T.n--
		fmt.Println("Berhasil! Data menu dihapus.")
	} else {
		fmt.Println("Menu tidak ditemukan.")
	}
}

