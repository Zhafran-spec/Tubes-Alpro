// Konstanta batas maksimum menu
const NMAX = 100

// Struct untuk spesifikasi poin b: rincian harga, komposisi, ketersediaan
type Menu struct {
	ID        string
	Nama      string
	Kategori  string
	Harga     float64
	Komposisi string
	Tersedia  bool
}

// Struct untuk menampung array of struct
type TabMenu struct {
	data [NMAX]Menu
	n    int
}

func main() {
	var daftarMenu TabMenu
	var pilihanUtama int
	var selesaiUtama bool = false

	for !selesaiUtama {
		fmt.Println("\n=== APLIKASI KATALOG MENU DIGITAL CAFE (CAFE-MENU) ===")
		fmt.Println("1. Akses Admin (Kelola Menu)")
		fmt.Println("2. Akses Pelanggan (Cari & Urutkan)")
		fmt.Println("0. Keluar")
		fmt.Print("Pilih akses pengguna: ")
		fmt.Scan(&pilihanUtama)

		if pilihanUtama == 0 {
			selesaiUtama = true
			fmt.Println("Terima kasih telah menggunakan aplikasi Cafe-Menu.")
		} else if pilihanUtama == 1 {
			menuAdmin(&daftarMenu)
		} else if pilihanUtama == 2 {
			menuPelanggan(&daftarMenu)
		} else {
			fmt.Println("Pilihan tidak valid.")
		}
	}
}

