// Fitur: Menghitung total pesanan pelanggan
func hitungTotalPesanan(T TabMenu) {
	var totalBelanja float64 = 0
	var selesaiPesan bool = false
	var idCari string
	var jumlah int

	fmt.Println("\n--- KASIR / HITUNG PESANAN ---")
	if T.n == 0 {
		fmt.Println("Katalog menu masih kosong, tidak bisa memesan.")
	}

	for !selesaiPesan && T.n > 0 {
		fmt.Print("Masukkan ID Menu yang dipesan (ketik 'SELESAI' untuk berhenti): ")
		fmt.Scan(&idCari)

		if idCari == "SELESAI" {
			selesaiPesan = true
		} else {
			var found bool = false
			var i int = 0
			
			// Pencarian menu menggunakan boolean flag
			for i < T.n && !found {
				if T.data[i].ID == idCari {
					found = true
					if T.data[i].Tersedia {
						fmt.Print("Masukkan jumlah pesanan: ")
						fmt.Scan(&jumlah)
						var subtotal float64 = T.data[i].Harga * float64(jumlah)
						totalBelanja = totalBelanja + subtotal
						fmt.Printf("Ditambahkan: %d x %s (Subtotal: Rp%.2f)\n", jumlah, T.data[i].Nama, subtotal)
					} else {
						fmt.Println("Maaf, menu tersebut sedang tidak tersedia (habis).")
					}
				}
				i++
			}

			if !found {
				fmt.Println("Menu dengan ID tersebut tidak ditemukan.")
			}
		}
	}

	if T.n > 0 {
		fmt.Printf("\n=== TOTAL YANG HARUS DIBAYAR: Rp%.2f ===\n", totalBelanja)
	}
}
