// Poin C: Sequential Search berdasarkan Kategori
func searchSequentialKategori(T TabMenu) {
	var katCari string
	fmt.Print("Masukkan kategori (contoh: coffee): ")
	fmt.Scan(&katCari)

	var found bool = false
	var i int = 0
	fmt.Println("--- HASIL PENCARIAN (SEQUENTIAL) ---")
	for i < T.n {
		if T.data[i].Kategori == katCari {
			tampilSatuMenu(T.data[i])
			found = true
		}
		i++
	}
	if !found {
		fmt.Println("Tidak ada menu untuk kategori tersebut.")
	}
}

// Poin C: Binary Search berdasarkan Kategori
func searchBinaryKategori(T *TabMenu) {
	// Binary Search mensyaratkan data harus terurut lebih dulu berdasarkan elemen yang dicari
	sortKategoriASC(T)

	var katCari string
	fmt.Print("Masukkan kategori (contoh: coffee): ")
	fmt.Scan(&katCari)

	var kiri int = 0
	var kanan int = T.n - 1
	var idxFound int = -1
	var done bool = false

	for kiri <= kanan && !done {
		var tengah int = (kiri + kanan) / 2
		if T.data[tengah].Kategori == katCari {
			idxFound = tengah
			done = true
		} else if T.data[tengah].Kategori < katCari {
			kiri = tengah + 1
		} else {
			kanan = tengah - 1
		}
	}

	if idxFound != -1 {
		// Tarik indeks ke belakang jika ada duplikat kategori agar tercetak semua
		var i int = idxFound
		for i > 0 && T.data[i-1].Kategori == katCari {
			i--
		}

		var stop bool = false
		fmt.Println("--- HASIL PENCARIAN (BINARY) ---")
		for i < T.n && !stop {
			if T.data[i].Kategori == katCari {
				tampilSatuMenu(T.data[i])
				i++
			} else {
				stop = true
			}
		}
	} else {
		fmt.Println("Tidak ada menu untuk kategori tersebut.")
	}
}

// Pengurutan string kategori Ascending sebagai prasyarat Binary Search
func sortKategoriASC(T *TabMenu) {
	var i int = 1
	for i < T.n {
		var temp Menu = T.data[i]
		var j int = i
		for j > 0 && T.data[j-1].Kategori > temp.Kategori {
			T.data[j] = T.data[j-1]
			j--
		}
		T.data[j] = temp
		i++
	}
}

// Poin D: Selection Sort berdasarkan Harga (Termurah ke Termahal)
func sortSelectionHargaASC(T *TabMenu) {
	var i int = 0
	for i < T.n-1 {
		var minIdx int = i
		var j int = i + 1
		for j < T.n {
			if T.data[j].Harga < T.data[minIdx].Harga {
				minIdx = j
			}
			j++
		}
		var temp Menu = T.data[i]
		T.data[i] = T.data[minIdx]
		T.data[minIdx] = temp
		i++
	}
	fmt.Println("Menu berhasil diurutkan berdasarkan harga (Selection Sort).")
}

// Poin D: Insertion Sort berdasarkan Harga (Termurah ke Termahal)
func sortInsertionHargaASC(T *TabMenu) {
	var i int = 1
	for i < T.n {
		var temp Menu = T.data[i]
		var j int = i
		for j > 0 && T.data[j-1].Harga > temp.Harga {
			T.data[j] = T.data[j-1]
			j--
		}
		T.data[j] = temp
		i++
	}
	fmt.Println("Menu berhasil diurutkan berdasarkan harga (Insertion Sort).")
}

// Poin E: Statistik jumlah menu per kategori & rata-rata harga
func tampilStatistik(T TabMenu) {
	if T.n == 0 {
		fmt.Println("Katalog masih kosong, tidak ada statistik.")
	} else {
		var totalHarga float64 = 0

		// Array lokal untuk menyimpan hasil rekap kategori
		type StatKategori struct {
			Nama   string
			Jumlah int
		}
		var arrStat [NMAX]StatKategori
		var nStat int = 0

		var i int = 0
		for i < T.n {
			totalHarga += T.data[i].Harga
			
			var foundKat bool = false
			var j int = 0
			// Cek apakah kategori sudah ada di array rekap
			for j < nStat && !foundKat {
				if arrStat[j].Nama == T.data[i].Kategori {
					arrStat[j].Jumlah++
					foundKat = true
				}
				j++
			}
			// Jika belum ada, masukkan sebagai kategori baru
			if !foundKat {
				arrStat[nStat].Nama = T.data[i].Kategori
				arrStat[nStat].Jumlah = 1
				nStat++
			}
			i++
		}

		var rataRata float64 = totalHarga / float64(T.n)

		fmt.Println("\n=== STATISTIK CAFE ===")
		fmt.Printf("Rata-rata Harga Seluruh Menu : Rp%.2f\n", rataRata)
		fmt.Println("Jumlah Menu per Kategori     :")
		var k int = 0
		for k < nStat {
			fmt.Printf(" - %s : %d item\n", arrStat[k].Nama, arrStat[k].Jumlah)
			k++
		}
	}
}
